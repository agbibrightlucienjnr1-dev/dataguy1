generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String          @id @default(uuid())
  name                String
  email               String          @unique
  phone               String
  passwordHash        String          @map("password_hash")
  role                UserRole        @default(agent)
  parentAgentId       String?         @map("parent_agent_id")
  createdAt           DateTime        @default(now()) @map("created_at")
  agentCode           Int             @unique @map("agent_code")
  paymentLinkCode     String?         @unique @map("payment_link_code")
  shopName            String?         @map("shop_name")
  preferences         Json?
  agentPrices         AgentPrice[]
  orders              Order[]         @relation("SellerOrders")
  subAgentPrices      SubAgentPrice[]
  parentAgent         User?           @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  subAgents           User[]          @relation("AgentHierarchy")
  wallet              Wallet?
  approvedWithdrawals Withdrawal[]    @relation("ApprovedWithdrawals")
  withdrawals         Withdrawal[]    @relation("UserWithdrawals")
  visitorLogs         VisitorLog[]    @relation("SellerVisitorLogs")
  pushSubscriptions   PushSubscription[]

  @@map("users")
}

model DataBundle {
  id             String          @id @default(uuid())
  network        Network
  volume         String
  hubnetCost     Decimal         @map("hubnet_cost") @db.Decimal(10, 2)
  adminPrice     Decimal         @map("admin_price") @db.Decimal(10, 2)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  agentPrices    AgentPrice[]
  orders         Order[]
  subAgentPrices SubAgentPrice[]

  @@unique([network, volume])
  @@map("data_bundles")
}

model AgentPrice {
  id            String     @id @default(uuid())
  agentId       String     @map("agent_id")
  bundleId      String     @map("bundle_id")
  customerPrice Decimal    @map("customer_price") @db.Decimal(10, 2)
  subAgentPrice Decimal    @map("sub_agent_price") @db.Decimal(10, 2)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  agent         User       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bundle        DataBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([agentId, bundleId])
  @@map("agent_prices")
}

model SubAgentPrice {
  id            String     @id @default(uuid())
  subAgentId    String     @map("sub_agent_id")
  bundleId      String     @map("bundle_id")
  customerPrice Decimal    @map("customer_price") @db.Decimal(10, 2)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  bundle        DataBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  subAgent      User       @relation(fields: [subAgentId], references: [id], onDelete: Cascade)

  @@unique([subAgentId, bundleId])
  @@map("sub_agent_prices")
}

model Customer {
  id                    String    @id @default(uuid())
  phone                 String    @unique @map("phone")
  name                  String?   @map("name")
  totalOrdersCount      Int       @default(0) @map("total_orders_count")
  successfulOrdersCount Int       @default(0) @map("successful_orders_count")
  firstOrderAt          DateTime? @map("first_order_at")
  lastOrderAt           DateTime? @map("last_order_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("customers")
}

model Order {
  id                 String             @id @default(uuid())
  customerPhone      String             @map("customer_phone")
  customerName       String?            @map("customer_name")
  bundleId           String             @map("bundle_id")
  sellerId           String             @map("seller_id")
  sellerType         SellerType         @map("seller_type")
  pricePaid          Decimal            @map("price_paid") @db.Decimal(10, 2)
  status             OrderStatus        @default(pending)
  paymentReference   String?            @unique @map("payment_reference")
  paymentConfirmedAt DateTime?          @map("payment_confirmed_at")
  providerOrderId    String?            @map("hubnet_order_id")
  providerStatus     String?            @map("hubnet_status")
  providerResponse   String?            @map("hubnet_response")
  deliveryProvider   String             @default("hubnet") @map("delivery_provider")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  completedAt        DateTime?          @map("completed_at")
  commissionAmount   Decimal?           @map("commission_amount") @db.Decimal(10, 2)
  commissionPaid     Boolean            @default(false) @map("commission_paid")
  transactionFee     Decimal            @default(0) @map("transaction_fee") @db.Decimal(10, 2)
  paymentProvider    String             @default("paystack") @map("payment_provider")
  adminNotified      Boolean            @default(false) @map("admin_notified")
  bundle             DataBundle         @relation(fields: [bundleId], references: [id])
  seller             User               @relation("SellerOrders", fields: [sellerId], references: [id])
  walletTransaction  WalletTransaction?

  @@index([customerPhone])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Wallet {
  id             String              @id @default(uuid())
  userId         String              @unique @map("user_id")
  balance        Decimal             @default(0) @db.Decimal(10, 2)
  totalEarned    Decimal             @default(0) @map("total_earned") @db.Decimal(10, 2)
  totalWithdrawn Decimal             @default(0) @map("total_withdrawn") @db.Decimal(10, 2)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  transactions   WalletTransaction[]
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id            String            @id @default(uuid())
  walletId      String            @map("wallet_id")
  type          TransactionType
  amount        Decimal           @db.Decimal(10, 2)
  balanceBefore Decimal           @map("balance_before") @db.Decimal(10, 2)
  balanceAfter  Decimal           @map("balance_after") @db.Decimal(10, 2)
  status        TransactionStatus @default(completed)
  reference     String?
  description   String?
  orderId       String?           @unique @map("order_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  order         Order?            @relation(fields: [orderId], references: [id])
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Withdrawal {
  id                    String           @id @default(uuid())
  userId                String           @map("user_id")
  amount                Decimal          @db.Decimal(10, 2)
  fee                   Decimal          @default(0.0) @db.Decimal(10, 2)
  accountType           BankAccountType  @map("account_type")
  accountNumber         String           @map("account_number")
  accountName           String           @map("account_name")
  bankName              String?          @map("bank_name")
  mobileNetwork         String?          @map("mobile_network")
  status                WithdrawalStatus @default(pending)
  reference             String           @unique
  paystackRecipientCode String?          @map("paystack_recipient_code")
  paystackTransferCode  String?          @map("paystack_transfer_code")
  paystackResponse      String?          @map("paystack_response")
  adminNote             String?          @map("admin_note")
  approvedBy            String?          @map("approved_by")
  approvedAt            DateTime?        @map("approved_at")
  processedAt           DateTime?        @map("processed_at")
  completedAt           DateTime?        @map("completed_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  approver              User?            @relation("ApprovedWithdrawals", fields: [approvedBy], references: [id])
  user                  User             @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("withdrawals")
}

model SystemSettings {
  id                    String   @id @default("global")
  activePaymentProvider  String   @default("paystack") @map("active_payment_provider")
  activeDeliveryProvider String   @default("hubnet") @map("active_delivery_provider")
  
  // Moolre Fees
  moolreFeePercentage   Decimal  @default(5.0) @map("moolre_fee_percentage") @db.Decimal(5, 2)
  moolreFlatFee        Decimal  @default(0.5) @map("moolre_flat_fee") @db.Decimal(10, 2)
  
  // Paystack Fees
  paystackFeePercentage Decimal  @default(1.95) @map("paystack_fee_percentage") @db.Decimal(5, 2)
  paystackFlatFee      Decimal  @default(0.0) @map("paystack_flat_fee") @db.Decimal(10, 2)
  
  allowAllUssdAccess    Boolean  @default(false) @map("allow_all_ussd_access")
  
  hubnetDepositFeePercentage Decimal  @default(3.0) @map("hubnet_deposit_fee_percentage") @db.Decimal(5, 2)
  
  disableWithdrawals    Boolean  @default(false) @map("disable_withdrawals")
  
  withdrawalFlatFee      Decimal  @default(0.5) @map("withdrawal_flat_fee") @db.Decimal(10, 2)
  withdrawalFeePercentage Decimal  @default(2.0) @map("withdrawal_fee_percentage") @db.Decimal(5, 2)
  
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model UssdSession {
  id        String   @id // Moolre sessionId
  msisdn    String   // Caller phone number
  stage     String   @default("AWAIT_AGENT") // Current state machine stage
  agentId   String?  @map("agent_id")
  network   String?  // Selected network
  bundleId  String?  @map("bundle_id")
  recipient String?  // Recipient phone number
  page      Int      @default(0) // Pagination for bundle list
  orderId   String?  @map("order_id") // Created order reference
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ussd_sessions")
}

enum UserRole {
  admin
  agent
  sub_agent
}

enum Network {
  MTN
  AIRTELTIGO
  TELECEL
  AT
}

enum OrderStatus {
  pending
  payment_confirmed
  processing
  completed
  failed
  cancelled
}

enum SellerType {
  agent
  sub_agent
}

enum TransactionType {
  commission
  withdrawal
  refund
  adjustment
}

enum TransactionStatus {
  pending
  completed
  failed
}

enum WithdrawalStatus {
  pending
  approved
  processing
  completed
  failed
  rejected
}

enum BankAccountType {
  bank_account
  mobile_money
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  phone      String   @map("phone")
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  used       Boolean  @default(false) @map("used")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model VisitorLog {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  eventType  String   @map("event_type") 
  path       String?  @map("path")
  sellerId   String?  @map("seller_id")
  device     String?  @map("device")
  createdAt  DateTime @default(now()) @map("created_at")

  seller     User?    @relation("SellerVisitorLogs", fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([createdAt])
  @@index([sessionId])
  @@map("visitor_logs")
}

model PlatformExpense {
  id          String   @id @default(uuid())
  category    String   // e.g., "SMS", "Hosting", "Other"
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("platform_expenses")
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?  @map("user_id")
  phone     String?
  role      String   @default("customer") // "agent", "sub_agent", "customer"
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([role])
  @@map("push_subscriptions")
}

model Event {
  id                String              @id @default(uuid())
  slug              String              @unique
  title             String
  description       String?             @db.Text
  price             Decimal             @default(20.00) @db.Decimal(10, 2)
  eventDate         DateTime?           @map("event_date")
  whatsappGroupLink String?             @map("whatsapp_group_link")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  registrations     EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id                 String             @id @default(uuid())
  eventId            String             @map("event_id")
  fullName           String             @map("full_name")
  email              String?
  phone              String
  amountPaid         Decimal            @map("amount_paid") @db.Decimal(10, 2)
  paymentReference   String             @unique @map("payment_reference")
  paymentProvider    String             @default("paystack") @map("payment_provider")
  status             RegistrationStatus @default(pending)
  whatsappAccessed   Boolean            @default(false) @map("whatsapp_accessed")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([phone])
  @@index([status])
  @@index([paymentReference])
  @@map("event_registrations")
}

enum RegistrationStatus {
  pending
  confirmed
  failed
}

