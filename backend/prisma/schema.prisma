// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  agent
  sub_agent
}

enum Network {
  MTN
  VODAFONE
  AIRTELTIGO
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  phone           String
  passwordHash    String    @map("password_hash")
  role            UserRole  @default(agent)
  parentAgentId   String?   @map("parent_agent_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  
  // Relations
  parentAgent     User?     @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  subAgents       User[]    @relation("AgentHierarchy")
  
  @@map("users")
}

model DataBundle {
  id              String    @id @default(uuid())
  network         Network
  volume          String    // e.g. "1GB", "2GB", "5GB"
  hubnetCost      Decimal   @map("hubnet_cost") @db.Decimal(10, 2)
  adminPrice      Decimal   @map("admin_price") @db.Decimal(10, 2)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  @@unique([network, volume])
  @@map("data_bundles")
}


